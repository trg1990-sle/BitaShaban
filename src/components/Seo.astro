---
import { site } from '~/data/site';

export interface SeoProps {
  title?: string;
  description?: string;
  /** Path or absolute URL of a 1200×630 image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, image = '/og/default.jpg', imageAlt, type = 'website', published, jsonLd, noindex } =
  Astro.props as SeoProps;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const imageUrl = new URL(image, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? `${title ?? site.name}, on a sheet of blotting paper with an ink study`} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{published && <meta property="article:author" content={site.name} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? site.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

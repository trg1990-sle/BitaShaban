---
import { site } from '~/data/site';
import type { Post } from '~/lib/content';

interface Props {
  linePost?: Post;
}
const { linePost } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <p class="hero__kicker label" data-wet="block">{site.tagline}</p>

  <h1 class="hero__name" id="hero-title" data-wet="chars">
    <span class="hero__l1">Bita</span>{' '}
    <span class="hero__l2">Shaban<span class="hero__drop" data-ink-drop aria-hidden="true"></span></span>
  </h1>

  {
    linePost && (
      <a class="hero__line" href={linePost.url} data-wet="block">
        <span class="hero__quote">“{site.heroLine.text}”</span>
        <span class="label">
          From <span class="hero__from">{linePost.title}</span> <span aria-hidden="true">→</span>
        </span>
      </a>
    )
  }

  <p class="hero__cue label" aria-hidden="true">
    <span class="hero__cue-line"></span>Scroll, slowly
  </p>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: var(--gutter) 1fr minmax(0, auto) var(--gutter);
    grid-template-rows: calc(var(--header-h) + clamp(1rem, 4vh, 3rem)) auto 1fr auto;
    min-height: 100svh;
    padding-block-end: clamp(1.5rem, 4vh, 3rem);
  }
  .hero__kicker {
    grid-column: 2 / 4;
    grid-row: 2;
    color: var(--fg-2);
  }
  .hero__name {
    grid-column: 2 / 4;
    grid-row: 3;
    align-self: center;
    margin-block: 4vh;
    font-size: clamp(4.4rem, 18vw, 17.5rem);
    font-weight: 290;
    line-height: 0.82;
    letter-spacing: -0.035em;
    --wonk: 1;
  }
  .hero__l1,
  .hero__l2 {
    display: block;
  }
  .hero__l2 {
    padding-inline-start: 0.92em;
  }
  /* The full stop: in WebGL a drop falls here and blooms; otherwise CSS draws the blot. */
  .hero__drop {
    display: inline-block;
    width: 0.19em;
    height: 0.19em;
    margin-inline-start: 0.045em;
    border-radius: 50%;
    background: radial-gradient(circle at 45% 45%, var(--fg) 55%, color-mix(in oklab, var(--accent) 60%, transparent) 64%, transparent 71%);
    animation: hero-blot 1.8s var(--ease-ink) 1.1s both;
  }
  :global(html.ink-live) .hero__drop {
    background: none;
    animation: none;
  }
  @keyframes hero-blot {
    from {
      transform: scale(0);
    }
  }

  .hero__line {
    grid-column: 3;
    grid-row: 4;
    justify-self: end;
    display: grid;
    gap: 0.5rem;
    max-width: 25rem;
    text-decoration: none;
    text-align: end;
    text-wrap: balance;
  }
  .hero__quote {
    font-size: clamp(1.125rem, 0.9rem + 0.7vw, 1.5rem);
    font-style: italic;
    font-weight: 340;
    line-height: 1.35;
    transition: color var(--quick) ease;
  }
  .hero__line .label {
    color: var(--fg-2);
  }
  .hero__line:hover .hero__quote {
    color: var(--accent);
  }
  .hero__from {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .hero__cue {
    grid-column: 2;
    grid-row: 4;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--fg-2);
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 2.75rem;
    overflow: hidden;
    background: color-mix(in oklab, var(--fg) 15%, transparent);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: cue 2.6s var(--ease-paper) infinite;
  }
  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (max-width: 40rem) {
    .hero__name {
      font-size: 23vw;
      line-height: 0.86;
    }
    .hero__l2 {
      padding-inline-start: 0.42em;
    }
    .hero {
      grid-template-columns: var(--gutter) 1fr var(--gutter);
      grid-template-rows: calc(var(--header-h) + 1.5rem) auto 1fr auto auto;
    }
    .hero__kicker,
    .hero__name {
      grid-column: 2;
    }
    .hero__line {
      grid-column: 2;
      grid-row: 4;
      justify-self: start;
      text-align: start;
      margin-block-end: 2rem;
    }
    .hero__cue {
      grid-row: 5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after {
      animation: none;
      transform: none;
    }
    .hero__drop {
      animation: none;
    }
  }
</style>

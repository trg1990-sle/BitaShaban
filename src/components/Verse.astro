---
// Renders a poem exactly as written: one element per line, measured indents,
// kept caesuras, hanging indents for wrapped turnovers, stanza gaps as written.
import type { VerseBlock } from '~/lib/content';
import { escapeHtml, verseLineHtml } from '~/lib/render';

interface Props {
  blocks: VerseBlock[];
  maxIndent: number;
  lineCount: number;
  /** 'fragments' numbers each stanza. */
  mode?: 'poem' | 'fragments';
  size?: 'body' | 'display';
  /** Animate lines in as they reach the screen. */
  reveal?: boolean;
  class?: string;
}

const { blocks, maxIndent, lineCount, mode = 'poem', size = 'body', reveal = true, class: cls } = Astro.props;
const numbered = mode === 'poem' && lineCount > 24;
let fragment = 0;

const html = blocks
  .map((b) => {
    if (b.type === 'heading') return `<h2 class="verse__section">${escapeHtml(b.text)}</h2>`;
    const n = mode === 'fragments' ? ++fragment : 0;
    const num = n
      ? `<span class="verse__frag label"><span class="visually-hidden">Fragment </span>${n}</span>`
      : '';
    return `<p class="stanza" style="--gap:${b.gap}">${num}${b.lines.map(verseLineHtml).join('')}</p>`;
  })
  .join('');
---

<div
  class:list={['verse', `verse--${size}`, `verse--${mode}`, { 'verse--numbered': numbered }, cls]}
  style={`--max-indent:${Math.max(maxIndent, 1)}`}
  data-reveal={reveal ? 'lines' : undefined}
  data-quotable
  set:html={html}
/>

<style>
  .verse {
    container-type: inline-size;
    font-size: var(--text);
    line-height: 1.62;
    font-weight: 380;
    font-variant-ligatures: common-ligatures;
  }
  .verse--display {
    font-size: calc(clamp(1.15rem, 0.75rem + 1.9vw, 2.35rem) * var(--reading-scale));
    line-height: 1.5;
    font-weight: 340;
  }

  .verse :global(.stanza) {
    position: relative;
    /* A blank line in the source is one line-height of space. Two blank lines, two. */
    margin-block-start: calc(var(--gap) * 1lh);
    /* the indent unit shrinks on narrow screens so deep indents keep their shape */
    --unit: max(0.12em, min(0.5em, calc((100cqi - 8em) / var(--max-indent))));
    --hang: 1.6em;
  }
  .verse :global(.verse__section) {
    margin-block: 2.6lh 0.9lh;
    font-family: var(--mono);
    font-size: var(--label);
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--fg-2);
    line-height: 1.4;
    font-variation-settings: normal;
  }
  .verse :global(.verse__section:first-child) {
    margin-block-start: 0;
  }

  .verse :global(.line) {
    display: block;
    padding-inline-start: calc(var(--i) * var(--unit) + var(--hang));
    text-indent: calc(-1 * var(--hang));
    overflow-wrap: break-word;
  }
  .verse :global(.line__lead) {
    /* the original spaces stay in the DOM (copy/paste), the indent is drawn by padding */
    white-space: pre;
    font-size: 0;
  }
  .verse :global(.sp) {
    display: inline-block;
    width: calc(var(--w) * var(--unit));
    overflow: hidden;
    white-space: pre;
    vertical-align: top;
    text-indent: 0;
  }
  .verse :global(em) {
    font-style: italic;
  }

  /* line numbers every fifth line in long poems, in the margin */
  .verse--numbered :global(.line[data-n$='0'])::before,
  .verse--numbered :global(.line[data-n$='5'])::before {
    content: attr(data-n);
    content: attr(data-n) / '';
    position: absolute;
    inset-inline-start: -3.25rem;
    width: 2.25rem;
    text-align: end;
    text-indent: 0;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: inherit;
    color: var(--fg-2);
    opacity: 0.8;
    font-variation-settings: normal;
  }
  .verse--numbered :global(.line) {
    position: relative;
  }

  .verse--fragments :global(.stanza) {
    margin-block-start: calc(max(var(--gap), 1) * 1.6lh);
  }
  .verse :global(.verse__frag) {
    position: absolute;
    inset-inline-start: -3.25rem;
    top: 0.5em;
    width: 2.25rem;
    text-align: end;
    color: var(--fg-2);
  }

  @media (max-width: 47.99rem) {
    .verse--numbered :global(.line[data-n$='0'])::before,
    .verse--numbered :global(.line[data-n$='5'])::before {
      display: none;
    }
    .verse :global(.verse__frag) {
      position: static;
      display: block;
      text-align: start;
      margin-block-end: 0.35rem;
    }
  }
</style>
